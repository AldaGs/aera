<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/typeTime"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/btn_rounded"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="@string/goal_time" />

            <Button
                android:id="@+id/typeDistance"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_rounded"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="@string/goal_distance" />

            <Button
                android:id="@+id/typeEither"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_rounded"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="@string/goal_either" />
        </LinearLayout>

        <TextView
            android:id="@+id/timeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="30 min" />

        <LinearLayout
            android:id="@+id/timeButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <Button android:id="@+id/timeMinus5" android:layout_width="wrap_content" android:layout_height="32dp"
                android:background="@drawable/btn_rounded" android:textColor="#FFFFFF" android:textSize="11sp" android:text="-5" />
            <Button android:id="@+id/timeMinus1" android:layout_width="wrap_content" android:layout_height="32dp"
                android:layout_marginStart="4dp" android:background="@drawable/btn_rounded" android:textColor="#FFFFFF" android:textSize="11sp" android:text="-1" />
            <Button android:id="@+id/timePlus1" android:layout_width="wrap_content" android:layout_height="32dp"
                android:layout_marginStart="4dp" android:background="@drawable/btn_rounded" android:textColor="#FFFFFF" android:textSize="11sp" android:text="+1" />
            <Button android:id="@+id/timePlus5" android:layout_width="wrap_content" android:layout_height="32dp"
                android:layout_marginStart="4dp" android:background="@drawable/btn_rounded" android:textColor="#FFFFFF" android:textSize="11sp" android:text="+5" />
        </LinearLayout>

        <TextView
            android:id="@+id/distValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="5 km" />

        <LinearLayout
            android:id="@+id/distButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <Button android:id="@+id/distMinus1" android:layout_width="wrap_content" android:layout_height="32dp"
                android:background="@drawable/btn_rounded" android:textColor="#FFFFFF" android:textSize="11sp" android:text="-1" />
            <Button android:id="@+id/distMinusHalf" android:layout_width="wrap_content" android:layout_height="32dp"
                android:layout_marginStart="4dp" android:background="@drawable/btn_rounded" android:textColor="#FFFFFF" android:textSize="11sp" android:text="-0.5" />
            <Button android:id="@+id/distPlusHalf" android:layout_width="wrap_content" android:layout_height="32dp"
                android:layout_marginStart="4dp" android:background="@drawable/btn_rounded" android:textColor="#FFFFFF" android:textSize="11sp" android:text="+0.5" />
            <Button android:id="@+id/distPlus1" android:layout_width="wrap_content" android:layout_height="32dp"
                android:layout_marginStart="4dp" android:background="@drawable/btn_rounded" android:textColor="#FFFFFF" android:textSize="11sp" android:text="+1" />
        </LinearLayout>

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_rounded"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/start" />
    </LinearLayout>
</ScrollView>
