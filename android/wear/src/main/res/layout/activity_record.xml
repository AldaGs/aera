<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/recStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#3BA0FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="" />

        <TextView
            android:id="@+id/recElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="0:00" />

        <TextView
            android:id="@+id/recDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A8A99"
            android:textSize="14sp"
            android:text="0.00 km" />

        <TextView
            android:id="@+id/recHr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF5A1F"
            android:textSize="14sp"
            android:text="-- bpm" />

        <TextView
            android:id="@+id/recCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF5A1F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="" />

        <TextView
            android:id="@+id/recAutoPaused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD54A"
            android:textSize="12sp"
            android:text="Auto-paused"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/recPauseResume"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_rounded"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="Pause" />

            <Button
                android:id="@+id/recLap"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_rounded"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="Lap" />
        </LinearLayout>

        <Button
            android:id="@+id/recStop"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_rounded"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="Stop" />
    </LinearLayout>
</FrameLayout>
